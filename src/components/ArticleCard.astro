---
import type { Article } from '@data/articles';
import { categories } from '@data/articles';

interface Props {
  article: Article;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
const category = categories.find((c) => c.slug === article.category);
const dateStr = new Date(article.date).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Generate a gradient-based visual for the article card
const gradients: Record<string, string> = {
  'release-date': 'from-orange-500 via-pink-500 to-purple-600',
  'trailer-2': 'from-purple-600 via-pink-500 to-cyan-500',
  'map-size': 'from-cyan-500 via-blue-500 to-purple-600',
  'characters': 'from-pink-500 via-purple-500 to-indigo-600',
  'gameplay': 'from-green-500 via-cyan-500 to-blue-600',
  'pc-requirements': 'from-blue-500 via-purple-500 to-pink-600',
};
const gradient = gradients[article.image] || 'from-pink-500 via-purple-500 to-cyan-500';
---

<article class={`card group ${featured ? 'md:col-span-2' : ''}`}>
  <a href={`/news/${article.slug}`} class="block">
    <!-- Visual Header -->
    <div class={`relative h-48 ${featured ? 'md:h-64' : ''} bg-gradient-to-br ${gradient} overflow-hidden`}>
      <div class="absolute inset-0 opacity-20" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cpath d=&quot;M0 0h60v60H0z&quot; fill=&quot;none&quot;/%3E%3Cpath d=&quot;M30 0v60M0 30h60&quot; stroke=&quot;white&quot; stroke-width=&quot;0.5&quot;/%3E%3C/svg%3E');"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-vice-dark/80 to-transparent"></div>
      {category && (
        <span class={`absolute top-3 left-3 tag bg-vice-dark/80 text-${category.color === 'vice-pink' ? 'pink' : category.color === 'vice-purple' ? 'purple' : category.color === 'vice-cyan' ? 'cyan' : 'orange'}-400 border border-vice-border`}>
          {category.name}
        </span>
      )}
      <div class="absolute bottom-3 left-3 right-3">
        <h3 class={`font-display font-bold text-white leading-tight ${featured ? 'text-2xl' : 'text-lg'} group-hover:text-vice-pink transition-colors`}>
          {article.title}
        </h3>
      </div>
    </div>

    <!-- Content -->
    <div class="p-4">
      <p class="text-sm text-gray-400 line-clamp-2 mb-3">
        {article.description}
      </p>
      <div class="flex items-center gap-3 text-xs text-gray-500">
        <span>{dateStr}</span>
        <span class="w-1 h-1 rounded-full bg-gray-600"></span>
        <span>{article.author}</span>
      </div>
    </div>
  </a>
</article>

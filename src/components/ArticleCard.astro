---
import type { Article } from '@data/articles';
import { categories, getCategoryName } from '@data/articles';
import type { Lang } from '../i18n/ui';

interface Props {
  article: Article;
  featured?: boolean;
  lang?: Lang;
}

const { article, featured = false, lang = 'zh' } = Astro.props;
const category = categories.find((c) => c.slug === article.category);
const locale = lang === 'en' ? 'en-US' : 'zh-CN';
const dateStr = new Date(article.date).toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const prefix = lang === 'en' ? '/en' : '';

const tints: Record<string, string> = {
  'release-date': 'bg-vice-pink/10',
  'trailer-2': 'bg-vice-purple/10',
  'map-size': 'bg-vice-orange/10',
  'characters': 'bg-vice-yellow/10',
  'gameplay': 'bg-cyan-500/10',
  'pc-requirements': 'bg-vice-magenta/10',
};
const tint = tints[article.image] || 'bg-navy-100';
---

<article class={`card group ${featured ? 'md:col-span-2' : ''}`}>
  <a href={`${prefix}/news/${article.slug}`} class="block">
    <div class={`relative h-44 ${featured ? 'md:h-56' : ''} ${tint} overflow-hidden border-b border-navy-200`}>
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="text-6xl font-extrabold text-slate-100/5 tracking-tighter select-none">
          GTA6
        </span>
      </div>
      {category && (
        <span class={`absolute top-3 left-3 tag bg-navy/80 text-${category.color} border border-${category.color}/30`}>
          {getCategoryName(category.slug, lang)}
        </span>
      )}
    </div>

    <div class="p-5">
      <h3 class={`font-bold text-slate-100 leading-snug mb-2 group-hover:text-accent transition-colors ${featured ? 'text-xl' : 'text-base'}`}>
        {article.title}
      </h3>
      <p class="text-sm text-slate-300 line-clamp-2 mb-4 leading-relaxed">
        {article.description}
      </p>
      <div class="flex items-center gap-3 text-xs text-slate-400">
        <span>{dateStr}</span>
        <span class="w-1 h-1 rounded-full bg-slate-400"></span>
        <span>{article.author}</span>
      </div>
    </div>
  </a>
</article>

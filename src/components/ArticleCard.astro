---
import type { Article } from '@data/articles';
import { categories } from '@data/articles';

interface Props {
  article: Article;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
const category = categories.find((c) => c.slug === article.category);
const dateStr = new Date(article.date).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Subtle background tint per article
const tints: Record<string, string> = {
  'release-date': 'bg-orange-50',
  'trailer-2': 'bg-purple-50',
  'map-size': 'bg-cyan-50',
  'characters': 'bg-rose-50',
  'gameplay': 'bg-green-50',
  'pc-requirements': 'bg-blue-50',
};
const tint = tints[article.image] || 'bg-ink-50';
---

<article class={`card group ${featured ? 'md:col-span-2' : ''}`}>
  <a href={`/news/${article.slug}`} class="block">
    <!-- Visual Header -->
    <div class={`relative h-44 ${featured ? 'md:h-56' : ''} ${tint} overflow-hidden`}>
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="text-6xl font-extrabold text-ink-900/5 tracking-tighter select-none">
          GTA6
        </span>
      </div>
      {category && (
        <span class="absolute top-3 left-3 tag bg-white/90 text-ink-700 border border-ink-100">
          {category.name}
        </span>
      )}
    </div>

    <!-- Content -->
    <div class="p-5">
      <h3 class={`font-bold text-ink-900 leading-snug mb-2 group-hover:text-accent transition-colors ${featured ? 'text-xl' : 'text-base'}`}>
        {article.title}
      </h3>
      <p class="text-sm text-ink-500 line-clamp-2 mb-4 leading-relaxed">
        {article.description}
      </p>
      <div class="flex items-center gap-3 text-xs text-ink-400">
        <span>{dateStr}</span>
        <span class="w-1 h-1 rounded-full bg-ink-200"></span>
        <span>{article.author}</span>
      </div>
    </div>
  </a>
</article>

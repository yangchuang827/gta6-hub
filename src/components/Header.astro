---
import { categories, siteConfig } from '@data/articles';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-navy-200 bg-navy/90 backdrop-blur-xl">
  <div class="container-page">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-1.5">
        <span class="text-xl font-extrabold tracking-tight text-slate-100">GTA6</span>
        <span class="text-xl font-extrabold tracking-tight text-accent">Hub</span>
      </a>

      <nav class="hidden lg:flex items-center gap-1">
        <a
          href="/"
          class={`px-3 py-2 rounded text-sm font-medium transition-colors ${currentPath === '/' ? 'text-accent' : 'text-slate-300 hover:text-slate-100'}`}
        >
          首页
        </a>
        {categories.slice(0, 5).map((cat) => (
          <a
            href={`/category/${cat.slug}`}
            class={`px-3 py-2 rounded text-sm font-medium transition-colors ${currentPath === `/category/${cat.slug}` ? 'text-accent' : 'text-slate-300 hover:text-slate-100'}`}
          >
            {cat.name}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a
          href="/news"
          class="hidden sm:inline-flex items-center px-4 py-2 rounded text-sm font-semibold text-navy bg-accent hover:bg-accent-dark transition-colors"
        >
          全部资讯
        </a>

        <button
          id="menu-toggle"
          class="lg:hidden p-2 rounded text-slate-300 hover:text-accent hover:bg-navy-50"
          aria-label="菜单"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-navy-200 bg-navy">
    <nav class="container-page py-4 flex flex-col gap-1">
      <a href="/" class="px-3 py-2 rounded text-sm font-medium text-slate-300 hover:text-accent hover:bg-navy-50">首页</a>
      {categories.map((cat) => (
        <a
          href={`/category/${cat.slug}`}
          class="px-3 py-2 rounded text-sm font-medium text-slate-300 hover:text-accent hover:bg-navy-50"
        >
          {cat.name}
        </a>
      ))}
      <a href="/news" class="px-3 py-2 rounded text-sm font-semibold text-navy bg-accent mt-2 text-center">全部资讯</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>

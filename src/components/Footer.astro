---
import { categories, siteConfig } from '@data/articles';

const year = new Date().getFullYear();
---

<footer class="border-t border-vice-border bg-vice-darker mt-20">
  <div class="container-page py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="col-span-1 md:col-span-2">
        <a href="/" class="flex items-center gap-2 mb-4">
          <span class="text-2xl font-display font-extrabold gradient-text">GTA6 Hub</span>
        </a>
        <p class="text-sm text-gray-400 max-w-md leading-relaxed">
          {siteConfig.description}
        </p>
        <div class="flex gap-3 mt-4">
          <a
            href={siteConfig.social.youtube}
            target="_blank"
            rel="noopener"
            class="w-10 h-10 flex items-center justify-center rounded-lg bg-vice-card border border-vice-border text-gray-400 hover:text-vice-pink hover:border-vice-pink transition-colors"
            aria-label="YouTube"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a
            href="#"
            class="w-10 h-10 flex items-center justify-center rounded-lg bg-vice-card border border-vice-border text-gray-400 hover:text-vice-pink hover:border-vice-pink transition-colors"
            aria-label="Twitter"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-sm font-semibold text-white mb-4">分类</h3>
        <ul class="space-y-2">
          {categories.map((cat) => (
            <li>
              <a href={`/category/${cat.slug}`} class="text-sm text-gray-400 hover:text-vice-pink">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-sm font-semibold text-white mb-4">快速链接</h3>
        <ul class="space-y-2">
          <li><a href="/about" class="text-sm text-gray-400 hover:text-vice-pink">关于我们</a></li>
          <li><a href="/news" class="text-sm text-gray-400 hover:text-vice-pink">全部资讯</a></li>
          <li><a href="/privacy" class="text-sm text-gray-400 hover:text-vice-pink">隐私政策</a></li>
          <li><a href="/contact" class="text-sm text-gray-400 hover:text-vice-pink">联系我们</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-vice-border flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-gray-500">
        &copy; {year} {siteConfig.name}. 保留所有权利。GTA 和 Rockstar Games 是 Take-Two Interactive 的商标。
      </p>
      <p class="text-xs text-gray-500">
        本站为粉丝资讯网站，与 Rockstar Games 或 Take-Two Interactive 无官方关联。
      </p>
    </div>
  </div>
</footer>

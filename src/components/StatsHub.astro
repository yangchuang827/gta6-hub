---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// GTA6 key data
const RELEASE_DATE = '2026-11-19T00:00:00';
const ANNOUNCE_DATE = '2023-12-04T00:00:00';

const stats = [
  {
    value: '745M+',
    label: t(lang, 'stats.trailerViews'),
    icon: 'play',
    color: 'vice-pink',
    sub: lang === 'zh' ? '两部预告片全网累计' : 'Both trailers combined',
  },
  {
    value: '7+',
    label: t(lang, 'stats.recordsBroken'),
    icon: 'trophy',
    color: 'vice-yellow',
    sub: lang === 'zh' ? '含 3 项吉尼斯世界纪录' : 'incl. 3 Guinness records',
  },
  {
    value: '---',
    label: t(lang, 'stats.daysToLaunch'),
    icon: 'clock',
    color: 'accent',
    sub: lang === 'zh' ? '实时倒计时 ↓' : 'Live countdown below',
    id: 'stat-days',
  },
  {
    value: '5',
    label: t(lang, 'stats.awards'),
    icon: 'award',
    color: 'vice-purple',
    sub: lang === 'zh' ? '"最期待游戏" 连续获奖' : '"Most Anticipated" streak',
  },
];

const milestones = [
  {
    title: t(lang, 'stats.t1Title'),
    date: t(lang, 'stats.t1Date'),
    desc: t(lang, 'stats.t1Desc'),
    color: 'vice-pink',
    done: true,
  },
  {
    title: t(lang, 'stats.t2Title'),
    date: t(lang, 'stats.t2Date'),
    desc: t(lang, 'stats.t2Desc'),
    color: 'vice-purple',
    done: true,
  },
  {
    title: t(lang, 'stats.netflixTitle'),
    date: t(lang, 'stats.netflixDate'),
    desc: t(lang, 'stats.netflixDesc'),
    color: 'vice-orange',
    done: false,
  },
  {
    title: t(lang, 'stats.releaseTitle'),
    date: t(lang, 'stats.releaseDateShort'),
    desc: t(lang, 'stats.releaseDesc'),
    color: 'accent',
    done: false,
  },
];

const facts = [
  { label: t(lang, 'stats.factSetting'), value: t(lang, 'stats.factSettingVal') },
  { label: t(lang, 'stats.factProtagonists'), value: t(lang, 'stats.factProtagonistsVal') },
  { label: t(lang, 'stats.factDeveloper'), value: t(lang, 'stats.factDeveloperVal') },
  { label: t(lang, 'stats.factMode'), value: t(lang, 'stats.factModeVal') },
];
---

<section class="stats-hub relative overflow-hidden border-y border-navy-200">
  <!-- Background neon grid -->
  <div class="absolute inset-0 stats-bg-grid opacity-30"></div>
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-vice-pink/50 to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-vice-purple/30 to-transparent"></div>

  <div class="container-page relative z-10 py-14 md:py-20">
    <!-- Section header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-100 mb-3 neon-text">
        {t(lang, 'stats.title')}
      </h2>
      <p class="text-slate-300 text-base md:text-lg">{t(lang, 'stats.subtitle')}</p>
    </div>

    <!-- Countdown Timer -->
    <div class="max-w-4xl mx-auto mb-10">
      <div class="relative rounded-2xl border border-navy-200 bg-navy-50/60 backdrop-blur-sm p-8 md:p-12 overflow-hidden">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-px bg-gradient-to-r from-transparent via-vice-pink to-transparent"></div>

        <p class="text-center text-sm md:text-base text-slate-300 mb-6 font-medium tracking-wide">
          {t(lang, 'stats.countdownLabel')}
        </p>

        <div id="countdown" class="grid grid-cols-4 gap-3 md:gap-6 max-w-2xl mx-auto">
          <div class="countdown-unit text-center">
            <div id="cd-days" class="countdown-number">--</div>
            <div class="countdown-label">{t(lang, 'countdown.days')}</div>
          </div>
          <div class="countdown-unit text-center">
            <div id="cd-hours" class="countdown-number">--</div>
            <div class="countdown-label">{t(lang, 'countdown.hours')}</div>
          </div>
          <div class="countdown-unit text-center">
            <div id="cd-minutes" class="countdown-number">--</div>
            <div class="countdown-label">{t(lang, 'countdown.minutes')}</div>
          </div>
          <div class="countdown-unit text-center">
            <div id="cd-seconds" class="countdown-number">--</div>
            <div class="countdown-label">{t(lang, 'countdown.seconds')}</div>
          </div>
        </div>

        <div class="text-center mt-6">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-navy/60 border border-vice-pink/20 text-slate-200 text-xs md:text-sm font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-vice-pink animate-pulse"></span>
            {t(lang, 'stats.releaseDate')} · {t(lang, 'stats.platforms')}
          </span>
        </div>

        <!-- Progress bar -->
        <div class="mt-8 max-w-2xl mx-auto">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
            <span>{t(lang, 'stats.progressSince')}</span>
            <span class="text-slate-300 font-medium">{t(lang, 'stats.progressLabel')}</span>
            <span>{t(lang, 'stats.progressUntil')}</span>
          </div>
          <div class="h-2 rounded-full bg-navy-200 overflow-hidden relative">
            <div id="progress-bar" class="h-full rounded-full bg-gradient-to-r from-vice-pink via-vice-purple to-accent transition-all duration-1000 relative">
              <div class="absolute right-0 top-0 bottom-0 w-8 bg-gradient-to-r from-transparent to-white/30 animate-pulse-slow"></div>
            </div>
          </div>
          <div class="text-right mt-1.5">
            <span id="progress-pct" class="text-xs text-accent font-mono font-semibold">0%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-14">
      {stats.map((stat) => (
        <div class="stat-card group relative rounded-xl border border-navy-200 bg-navy-50/50 p-5 md:p-6 transition-all duration-300 hover:border-vice-pink/40">
          <div class={`absolute top-0 left-0 right-0 h-0.5 bg-${stat.color} rounded-t-xl opacity-60 group-hover:opacity-100 transition-opacity`}></div>
          <div class="flex items-center gap-2 mb-3">
            <div class={`w-8 h-8 rounded-lg bg-${stat.color}/10 border border-${stat.color}/20 flex items-center justify-center`}>
              {stat.icon === 'play' && <svg class={`w-4 h-4 text-${stat.color}`} fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>}
              {stat.icon === 'trophy' && <svg class={`w-4 h-4 text-${stat.color}`} fill="currentColor" viewBox="0 0 24 24"><path d="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.4 5 9.3 5 8z"/></svg>}
              {stat.icon === 'clock' && <svg class={`w-4 h-4 text-${stat.color}`} fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.4 0-8-3.6-8-8s3.6-8 8-8 8 3.6 8 8-3.6 8-8 8zm.5-13H11v6l5.2 3.2.8-1.3-4.5-2.7z"/></svg>}
              {stat.icon === 'award' && <svg class={`w-4 h-4 text-${stat.color}`} fill="currentColor" viewBox="0 0 24 24"><path d="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.4 5 9.3 5 8z"/></svg>}
            </div>
          </div>
          <div id={stat.id} class={`text-2xl md:text-3xl font-extrabold text-${stat.color} font-mono tracking-tight mb-1`}>
            {stat.value}
          </div>
          <div class="text-sm text-slate-200 font-medium">{stat.label}</div>
          <div class="text-xs text-slate-400 mt-0.5">{stat.sub}</div>
        </div>
      ))}
    </div>

    <!-- Milestone Timeline -->
    <div class="mb-12">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h3 class="text-xl md:text-2xl font-bold text-slate-100">{t(lang, 'stats.timelineTitle')}</h3>
          <p class="text-sm text-slate-400 mt-1">{t(lang, 'stats.timelineSub')}</p>
        </div>
      </div>

      <div class="relative">
        <!-- Timeline line -->
        <div class="absolute top-6 left-0 right-0 h-0.5 bg-navy-200"></div>
        <div id="timeline-progress" class="absolute top-6 left-0 h-0.5 bg-gradient-to-r from-vice-pink via-vice-purple to-vice-orange transition-all duration-1000" style="width: 50%"></div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-2 relative">
          {milestones.map((ms, i) => (
            <div class="flex flex-col items-center text-center group">
              <div class={`relative w-12 h-12 rounded-full border-2 flex items-center justify-center mb-4 z-10 transition-all duration-300 ${ms.done ? `bg-${ms.color} border-${ms.color}` : 'bg-navy-50 border-navy-200'}`}>
                {ms.done ? (
                  <svg class="w-5 h-5 text-navy" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                ) : (
                  <span class={`w-2.5 h-2.5 rounded-full ${i === 2 ? `bg-${ms.color} animate-pulse` : 'bg-slate-400'}`}></span>
                )}
                {i === 2 && (
                  <div class={`absolute inset-0 rounded-full border-2 border-${ms.color} animate-ping opacity-40`}></div>
                )}
              </div>
              <div class="text-xs text-slate-400 font-mono mb-1">{ms.date}</div>
              <div class={`text-sm font-bold mb-1 ${ms.done ? 'text-slate-100' : 'text-slate-300'}`}>{ms.title}</div>
              <div class="text-xs text-slate-400 leading-relaxed max-w-[160px]">{ms.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Confirmed Facts -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
      {facts.map((fact) => (
        <div class="rounded-lg bg-navy-50/40 border border-navy-200 p-4">
          <div class="text-xs text-slate-400 uppercase tracking-wider mb-1.5">{fact.label}</div>
          <div class="text-sm font-semibold text-slate-100">{fact.value}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-bg-grid {
    background-image:
      linear-gradient(rgba(255, 0, 110, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(168, 85, 247, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .countdown-number {
    font-size: clamp(1.75rem, 5vw, 3.5rem);
    font-weight: 800;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    background: linear-gradient(135deg, #FF006E 0%, #A855F7 50%, #64FFDA 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    letter-spacing: -0.02em;
    transition: transform 0.3s ease;
  }

  .countdown-number.tick {
    transform: scale(1.05);
  }

  .countdown-label {
    font-size: clamp(0.7rem, 2vw, 0.875rem);
    color: #8892B0;
    margin-top: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .countdown-unit {
    position: relative;
  }

  .countdown-unit::after {
    content: ':';
    position: absolute;
    right: -6px;
    top: 50%;
    transform: translateY(-50%);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: #233554;
    font-family: monospace;
    font-weight: 700;
  }

  .countdown-unit:last-child::after {
    display: none;
  }

  @media (max-width: 640px) {
    .countdown-unit::after {
      right: -4px;
    }
  }

  .stat-card {
    backdrop-filter: blur(8px);
  }

  .stat-card:hover {
    box-shadow: 0 0 30px rgba(255, 0, 110, 0.08);
    transform: translateY(-2px);
  }
</style>

<script is:inline define:vars={{ RELEASE_DATE, ANNOUNCE_DATE, lang: lang }}>
  function updateCountdown() {
    const now = new Date().getTime();
    const release = new Date(RELEASE_DATE).getTime();
    const announce = new Date(ANNOUNCE_DATE).getTime();

    const diff = release - now;

    if (diff <= 0) {
      document.getElementById('cd-days').textContent = '0';
      document.getElementById('cd-hours').textContent = '00';
      document.getElementById('cd-minutes').textContent = '00';
      document.getElementById('cd-seconds').textContent = '00';
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    const daysEl = document.getElementById('cd-days');
    const hoursEl = document.getElementById('cd-hours');
    const minutesEl = document.getElementById('cd-minutes');
    const secondsEl = document.getElementById('cd-seconds');

    daysEl.textContent = days;
    hoursEl.textContent = String(hours).padStart(2, '0');
    minutesEl.textContent = String(minutes).padStart(2, '0');
    secondsEl.textContent = String(seconds).padStart(2, '0');

    // Animate seconds change
    secondsEl.classList.add('tick');
    setTimeout(() => secondsEl.classList.remove('tick'), 200);

    // Update stat card days
    const statDays = document.getElementById('stat-days');
    if (statDays) statDays.textContent = days;

    // Update progress bar
    const totalDuration = release - announce;
    const elapsed = now - announce;
    const pct = Math.min(100, Math.max(0, (elapsed / totalDuration) * 100));
    const progressBar = document.getElementById('progress-bar');
    const progressPct = document.getElementById('progress-pct');
    if (progressBar) progressBar.style.width = pct + '%';
    if (progressPct) progressPct.textContent = pct.toFixed(1) + '%';

    // Update timeline progress (milestones: 0%, 45%, 85%, 100%)
    const timelineProgress = document.getElementById('timeline-progress');
    if (timelineProgress) {
      let tlPct;
      if (pct < 45) tlPct = (pct / 45) * 25;
      else if (pct < 85) tlPct = 25 + ((pct - 45) / 40) * 25;
      else tlPct = 50 + ((pct - 85) / 15) * 50;
      tlPct = Math.min(100, Math.max(12, tlPct));
      timelineProgress.style.width = tlPct + '%';
    }
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import AdSlot from '@components/AdSlot.astro';
import { articles, categories, siteConfig } from '@data/articles';

const featuredArticles = articles.filter(a => a.featured);
const latestArticles = articles.slice(0, 6);
const popularArticles = articles.slice(2, 5);
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-vice-dark via-vice-darker to-black"></div>
    <div class="absolute inset-0 opacity-30">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-vice-pink rounded-full blur-[120px] animate-pulse-slow"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-vice-purple rounded-full blur-[120px] animate-pulse-slow" style="animation-delay: 1s;"></div>
      <div class="absolute top-1/2 left-1/2 w-72 h-72 bg-vice-cyan rounded-full blur-[100px] animate-pulse-slow" style="animation-delay: 2s;"></div>
    </div>

    <div class="relative container-page py-20 md:py-28 text-center">
      <span class="inline-block px-4 py-1.5 rounded-full bg-vice-pink/10 border border-vice-pink/30 text-vice-pink text-sm font-medium mb-6">
        Rockstar Games 官方确认 2025 年秋季发售
      </span>
      <h1 class="text-4xl md:text-6xl font-display font-extrabold mb-6 leading-tight">
        追踪 <span class="gradient-text">GTA6</span> 的<br class="hidden md:block" /> 每一个动态
      </h1>
      <p class="text-lg md:text-xl text-gray-400 max-w-2xl mx-auto mb-8 leading-relaxed">
        {siteConfig.description}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/news" class="btn-primary">
          浏览全部资讯
        </a>
        <a href="/news/gta6-trailer-2-breakdown" class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold text-white border border-vice-border bg-vice-card/50 hover:border-vice-pink/50 transition-colors">
          预告片解析
        </a>
      </div>
    </div>
  </section>

  <!-- Top Banner Ad -->
  <div class="container-page mt-8">
    <AdSlot slot="1111111111" label="横幅广告" />
  </div>

  <!-- Featured Articles -->
  <section class="container-page py-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-display font-bold">精选资讯</h2>
      <a href="/news" class="text-sm text-vice-cyan hover:text-vice-pink">查看全部 &rarr;</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredArticles.map((article) => (
        <ArticleCard article={article} featured />
      ))}
    </div>
  </section>

  <!-- In-content Ad -->
  <div class="container-page">
    <AdSlot slot="2222222222" label="内容广告" />
  </div>

  <!-- Latest News -->
  <section class="container-page py-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-display font-bold">最新动态</h2>
      <a href="/news" class="text-sm text-vice-cyan hover:text-vice-pink">更多 &rarr;</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {latestArticles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>

  <!-- Categories Grid -->
  <section class="container-page py-12">
    <h2 class="text-2xl font-display font-bold mb-6">浏览分类</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      {categories.map((cat) => (
        <a
          href={`/category/${cat.slug}`}
          class="card p-4 text-center group hover:border-vice-pink/50"
        >
          <div class={`w-12 h-12 mx-auto mb-3 rounded-lg bg-${cat.color === 'vice-pink' ? 'pink' : cat.color === 'vice-purple' ? 'purple' : cat.color === 'vice-cyan' ? 'cyan' : 'orange'}-500/10 flex items-center justify-center`}>
            <span class={`text-${cat.color === 'vice-pink' ? 'pink' : cat.color === 'vice-purple' ? 'purple' : cat.color === 'vice-cyan' ? 'cyan' : 'orange'}-400 text-lg font-bold`}>
              {cat.name.charAt(0)}
            </span>
          </div>
          <span class="text-sm font-medium text-gray-300 group-hover:text-white">{cat.name}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Popular + Sidebar Ad -->
  <section class="container-page py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-display font-bold mb-6">热门阅读</h2>
        <div class="space-y-4">
          {popularArticles.map((article, index) => (
            <a href={`/news/${article.slug}`} class="card p-4 flex items-start gap-4 group">
              <span class="text-3xl font-display font-extrabold gradient-text flex-shrink-0">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="font-semibold text-white group-hover:text-vice-pink transition-colors mb-1">{article.title}</h3>
                <p class="text-sm text-gray-400 line-clamp-1">{article.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
      <div class="lg:col-span-1">
        <div class="sticky top-20">
          <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">赞助内容</h3>
          <AdSlot slot="3333333333" format="rectangle" label="侧边栏广告" className="min-h-[250px]" />
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="container-page py-12">
    <div class="card p-8 md:p-12 text-center bg-gradient-to-br from-vice-card to-vice-darker">
      <h2 class="text-2xl md:text-3xl font-display font-bold mb-4">不要错过任何 GTA6 消息</h2>
      <p class="text-gray-400 mb-6 max-w-xl mx-auto">订阅我们的更新，第一时间获取 GTA6 最新资讯、预告片解析和独家内容。</p>
      <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="return false;">
        <input
          type="email"
          placeholder="输入你的邮箱地址"
          class="flex-1 px-4 py-3 rounded-lg bg-vice-dark border border-vice-border text-white placeholder-gray-500 focus:outline-none focus:border-vice-pink"
        />
        <button type="submit" class="btn-primary whitespace-nowrap">立即订阅</button>
      </form>
      <p class="text-xs text-gray-500 mt-3">我们不会发送垃圾邮件，随时可取消订阅。</p>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import AdSlot from '@components/AdSlot.astro';
import { articles, categories } from '@data/articles';

const sortedArticles = [...articles].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const displayItems = [];
sortedArticles.forEach((article, index) => {
  displayItems.push({ type: 'article', data: article });
  if ((index + 1) % 4 === 0 && index < sortedArticles.length - 1) {
    displayItems.push({ type: 'ad', data: null });
  }
});
---

<BaseLayout
  title="全部资讯"
  description="浏览 GTA6 Hub 的全部资讯文章，包括最新新闻、预告片解析、角色介绍、玩法指南等内容。"
>
  <section class="border-b border-navy-200 relative">
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-vice-pink via-vice-purple to-vice-orange"></div>
    <div class="container-page py-12">
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-2 text-slate-100">全部资讯</h1>
      <p class="text-slate-300">共 {articles.length} 篇文章 · 持续更新中</p>
    </div>
  </section>

  <div class="container-page py-6">
    <div class="flex flex-wrap gap-2">
      <a href="/news" class="px-4 py-2 rounded text-sm font-medium bg-accent text-navy hover:shadow-[0_0_16px_rgba(100,255,218,0.25)] transition-all">
        全部
      </a>
      {categories.map((cat) => (
        <a
          href={`/category/${cat.slug}`}
          class={`px-4 py-2 rounded text-sm font-medium text-slate-300 bg-navy-50 border border-navy-200 hover:border-${cat.color}/50 hover:text-${cat.color} transition-colors`}
        >
          {cat.name}
        </a>
      ))}
    </div>
  </div>

  <div class="container-page pb-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayItems.map((item) => (
        item.type === 'article' ? (
          <ArticleCard article={item.data} />
        ) : (
          <div class="md:col-span-2 lg:col-span-3">
            <AdSlot slot="4444444444" label="信息流广告" />
          </div>
        )
      ))}
    </div>
  </div>
</BaseLayout>

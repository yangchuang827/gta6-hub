---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import AdSlot from '@components/AdSlot.astro';
import { articles, categories } from '@data/articles';

const sortedArticles = [...articles].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

// Insert ad every 4 articles
const displayItems = [];
sortedArticles.forEach((article, index) => {
  displayItems.push({ type: 'article', data: article });
  if ((index + 1) % 4 === 0 && index < sortedArticles.length - 1) {
    displayItems.push({ type: 'ad', data: null });
  }
});
---

<BaseLayout
  title="全部资讯"
  description="浏览 GTA6 Hub 的全部资讯文章，包括最新新闻、预告片解析、角色介绍、玩法指南等内容。"
>
  <!-- Page Header -->
  <section class="border-b border-vice-border bg-vice-darker">
    <div class="container-page py-10">
      <h1 class="text-3xl md:text-4xl font-display font-extrabold mb-2">全部资讯</h1>
      <p class="text-gray-400">共 {articles.length} 篇文章 · 持续更新中</p>
    </div>
  </section>

  <!-- Category Filter -->
  <div class="container-page py-6">
    <div class="flex flex-wrap gap-2">
      <a href="/news" class="px-4 py-2 rounded-lg text-sm font-medium bg-vice-pink/10 text-vice-pink border border-vice-pink/30">
        全部
      </a>
      {categories.map((cat) => (
        <a
          href={`/category/${cat.slug}`}
          class="px-4 py-2 rounded-lg text-sm font-medium text-gray-400 hover:text-white bg-vice-card border border-vice-border hover:border-vice-pink/30 transition-colors"
        >
          {cat.name}
        </a>
      ))}
    </div>
  </div>

  <!-- Articles Grid -->
  <div class="container-page pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayItems.map((item) => (
        item.type === 'article' ? (
          <ArticleCard article={item.data} />
        ) : (
          <div class="md:col-span-2 lg:col-span-3">
            <AdSlot slot="4444444444" label="信息流广告" />
          </div>
        )
      ))}
    </div>
  </div>
</BaseLayout>

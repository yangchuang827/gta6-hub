---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import AdSlot from '@components/AdSlot.astro';
import { getArticles, categories, getCategoryName } from '@data/articles';
import { t } from '../../../i18n/ui';

const lang = 'en' as const;
const allArticles = getArticles(lang);

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { cat },
  }));
}

const { cat } = Astro.props;
const categoryArticles = allArticles
  .filter((a) => a.category === cat.slug)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const catName = getCategoryName(cat.slug, lang);
---

<BaseLayout
  lang={lang}
  title={catName}
  description={`Browse all GTA6 ${catName} articles. ${categoryArticles.length} articles available.`}
  canonicalPath={`/category/${cat.slug}`}
>
  <section class="page-banner">
    <div class="page-banner-bg bg-category-vice"></div>
    <div class="absolute inset-0 page-banner-overlay"></div>
    <div class="absolute inset-0 page-banner-overlay-side"></div>
    <div class={`absolute top-0 left-0 right-0 h-1 bg-${cat.color}`}></div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-vice-pink/30 to-transparent"></div>
    <div class="container-page relative z-10 py-16 md:py-20">
      <div class="flex items-center gap-2 text-sm text-slate-400 mb-3">
        <a href="/en" class="hover:text-accent">{t(lang, 'nav.home')}</a>
        <span>/</span>
        <a href="/en/news" class="hover:text-accent">{t(lang, 'nav.news')}</a>
        <span>/</span>
        <span class={`text-${cat.color}`}>{catName}</span>
      </div>
      <h1 class={`text-3xl md:text-4xl font-extrabold tracking-tight mb-2 text-${cat.color}`}>{catName}</h1>
      <p class="text-slate-300">{categoryArticles.length} {t(lang, 'news.subtitle')}</p>
    </div>
  </section>

  <div class="container-page py-10">
    {categoryArticles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {categoryArticles.map((article) => (
          <ArticleCard article={article} lang={lang} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <p class="text-slate-300 mb-4">No articles in this category yet</p>
        <a href="/en/news" class="text-accent hover:text-accent-dark font-medium">{t(lang, 'nav.news')} &rarr;</a>
      </div>
    )}
  </div>

  <div class="container-page pb-10">
    <AdSlot slot="9999999999" label={t(lang, 'section.sponsored')} />
  </div>
</BaseLayout>

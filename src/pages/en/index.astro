---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import AdSlot from '@components/AdSlot.astro';
import StatsHub from '@components/StatsHub.astro';
import { getArticles, getFeaturedArticles, categories, siteConfig } from '@data/articles';
import { t } from '../../i18n/ui';

const lang = 'en' as const;
const allArticles = getArticles(lang);
const featuredArticles = getFeaturedArticles(lang);
const latestArticles = allArticles.slice(0, 6);
const popularArticles = allArticles.slice(2, 5);
---

<BaseLayout lang={lang} canonicalPath="/" fullPageBg={false}>
  <section class="relative min-h-[70vh] md:min-h-[75vh] flex items-center overflow-hidden border-b border-navy-200">
    <div class="absolute inset-0 bg-hero-vice bg-cover bg-center bg-no-repeat"></div>
    <div class="absolute inset-0 hero-gradient"></div>
    <div class="absolute inset-0 hero-vignette"></div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-vice-pink/50 to-transparent"></div>
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-vice-purple/30 to-transparent"></div>

    <div class="container-page relative z-10 py-20 md:py-28">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-navy/60 backdrop-blur-sm border border-vice-pink/30 text-vice-pink text-xs font-semibold mb-6 animate-fade-up">
          <span class="w-1.5 h-1.5 rounded-full bg-vice-pink animate-pulse"></span>
          {t(lang, 'hero.badge')}
        </span>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6 leading-[1.1] text-white neon-text animate-fade-up">
          {t(lang, 'hero.title')}<br />
          <span class="bg-gradient-to-r from-vice-pink via-vice-purple to-vice-orange bg-clip-text text-transparent">{t(lang, 'hero.titleHighlight')}</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-200 max-w-2xl mb-10 leading-relaxed animate-fade-up">
          {siteConfig.descriptionEn}
        </p>
        <div class="flex flex-wrap items-center gap-3 animate-fade-up">
          <a href="/en/news" class="btn-primary">
            {t(lang, 'hero.cta1')}
          </a>
          <a href="/en/news/gta6-trailer-2-breakdown" class="btn-secondary">
            {t(lang, 'hero.cta2')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="container-page mt-8">
    <AdSlot slot="1111111111" label={t(lang, 'section.sponsored')} />
  </div>

  <StatsHub lang={lang} />

  <section class="container-page py-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-100">{t(lang, 'section.featured')}</h2>
      <a href="/en/news" class="text-sm text-accent hover:text-accent-dark font-medium">{t(lang, 'section.viewAll')} &rarr;</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredArticles.map((article) => (
        <ArticleCard article={article} featured lang={lang} />
      ))}
    </div>
  </section>

  <div class="container-page">
    <AdSlot slot="2222222222" label={t(lang, 'section.sponsored')} />
  </div>

  <section class="container-page py-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-100">{t(lang, 'section.latest')}</h2>
      <a href="/en/news" class="text-sm text-accent hover:text-accent-dark font-medium">{t(lang, 'section.more')} &rarr;</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {latestArticles.map((article) => (
        <ArticleCard article={article} lang={lang} />
      ))}
    </div>
  </section>

  <section class="bg-navy-50/30 border-y border-navy-200 relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-vice-purple/20 to-transparent"></div>
    <div class="container-page py-16 relative z-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-100 mb-8">{t(lang, 'section.categories')}</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {categories.map((cat) => (
          <a href={`/en/category/${cat.slug}`} class="card p-5 text-center group relative">
            <div class={`absolute top-0 left-0 right-0 h-0.5 bg-${cat.color}`}></div>
            <div class={`w-10 h-10 mx-auto mb-3 rounded-lg bg-${cat.color}/10 border border-${cat.color}/30 flex items-center justify-center`}>
              <span class={`text-${cat.color} text-sm font-bold`}>
                {cat.nameEn.charAt(0)}
              </span>
            </div>
            <span class="text-sm font-medium text-slate-300 group-hover:text-white">{cat.nameEn}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-100 mb-8">{t(lang, 'section.popular')}</h2>
        <div class="space-y-5">
          {popularArticles.map((article, index) => (
            <a href={`/en/news/${article.slug}`} class="card p-5 flex items-start gap-5 group relative">
              <span class="absolute top-0 left-0 bottom-0 w-1 bg-gradient-to-b from-vice-pink to-vice-purple rounded-l opacity-0 group-hover:opacity-100 transition-opacity"></span>
              <span class="text-3xl font-extrabold text-slate-400/30 flex-shrink-0 w-10 font-mono group-hover:text-vice-pink transition-colors">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="font-semibold text-slate-100 group-hover:text-white transition-colors mb-1">{article.title}</h3>
                <p class="text-sm text-slate-300 line-clamp-1">{article.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
      <div class="lg:col-span-1">
        <div class="sticky top-20">
          <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-4">{t(lang, 'section.sponsored')}</h3>
          <AdSlot slot="3333333333" format="rectangle" label={t(lang, 'section.sponsored')} className="min-h-[250px]" />
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="relative rounded-2xl border border-navy-200 p-10 md:p-16 text-center overflow-hidden cta-gradient neon-border">
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-vice-pink/50 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-vice-purple/50 to-transparent"></div>
      <div class="relative z-10">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">{t(lang, 'section.subscribe')}</h2>
        <p class="text-slate-300 mb-8 max-w-xl mx-auto">{t(lang, 'section.subscribeDesc')}</p>
        <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="return false;">
          <input
            type="email"
            placeholder={t(lang, 'section.subscribePlaceholder')}
            class="flex-1 px-4 py-3 rounded bg-navy/80 border border-navy-200 text-slate-100 placeholder-slate-400 focus:outline-none focus:border-vice-pink"
          />
          <button type="submit" class="btn-primary whitespace-nowrap">{t(lang, 'section.subscribeBtn')}</button>
        </form>
        <p class="text-xs text-slate-400 mt-4">{t(lang, 'section.subscribeNote')}</p>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="Privacy Policy"
  description="GTA6 Hub Privacy Policy - Learn how we collect, use, and protect your personal information."
  noindex={true}
  canonicalPath="/privacy"
>
  <section class="page-banner">
    <div class="page-banner-bg bg-about-vice"></div>
    <div class="absolute inset-0 page-banner-overlay"></div>
    <div class="absolute inset-0 page-banner-overlay-side"></div>
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-vice-purple via-vice-pink to-vice-orange"></div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-vice-purple/30 to-transparent"></div>
    <div class="container-page relative z-10 py-16 md:py-20">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-3 text-white neon-text">Privacy Policy</h1>
      <p class="text-sm text-slate-300">Last updated: January 1, 2025</p>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="max-w-3xl mx-auto">
      <div class="prose-content">
        <p>
          This Privacy Policy describes how GTA6 Hub ("we", "us", or "our") collects, uses, and protects your information when you visit our website.
        </p>

        <h2>Information We Collect</h2>
        <p>
          We may collect the following types of information:
        </p>
        <ul>
          <li><strong>Automatically collected</strong>: IP address, browser type, pages visited, time spent</li>
          <li><strong>Voluntarily provided</strong>: Email address (if you subscribe to our newsletter)</li>
        </ul>

        <h2>How We Use Your Information</h2>
        <ul>
          <li>To provide and maintain our service</li>
          <li>To send updates and newsletters (if subscribed)</li>
          <li>To analyze website traffic and user behavior</li>
          <li>To display relevant advertising</li>
        </ul>

        <h2>Google AdSense</h2>
        <p>
          We use Google AdSense to display ads. Google may use cookies to serve ads based on your prior visits to this and other websites. You can opt out of personalized advertising by visiting <a href="https://www.google.com/settings/ads">Google Ad Settings</a>.
        </p>

        <h2>Cookies</h2>
        <p>
          We use cookies to improve your browsing experience. You can control cookies through your browser settings.
        </p>

        <h2>Contact</h2>
        <p>
          If you have questions about this Privacy Policy, please contact us at <a href="mailto:contact@gameinfos.org">contact@gameinfos.org</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

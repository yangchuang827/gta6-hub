---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="您访问的页面不存在。" noindex={true}>
  <section class="container-page py-20 text-center">
    <div class="max-w-md mx-auto">
      <h1 class="text-8xl font-display font-extrabold gradient-text mb-4">404</h1>
      <p class="text-xl text-gray-400 mb-8">抱歉，您访问的页面不存在或已被移除。</p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="btn-primary">返回首页</a>
        <a href="/news" class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold text-white border border-vice-border bg-vice-card/50 hover:border-vice-pink/50 transition-colors">
          浏览资讯
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

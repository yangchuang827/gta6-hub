---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="您访问的页面不存在。" noindex={true}>
  <section class="container-page py-24 text-center">
    <div class="max-w-md mx-auto">
      <h1 class="text-7xl font-extrabold tracking-tight text-accent mb-4">404</h1>
      <p class="text-lg text-ink-500 mb-8">抱歉，您访问的页面不存在或已被移除。</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="btn-primary">返回首页</a>
        <a href="/news" class="btn-secondary">浏览资讯</a>
      </div>
    </div>
  </section>
</BaseLayout>
